{
  "name": "vcp-mobile",
  "private": true,
  "version": "1.0.8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "android:debug": "node tests/e2e-android/scripts/android-debug-agent.cjs",
    "android:debug:doctor": "node tests/e2e-android/scripts/android-debug-agent.cjs doctor",
    "android:debug:dev": "node tests/e2e-android/scripts/android-debug-agent.cjs dev",
    "android:debug:status": "node tests/e2e-android/scripts/android-debug-agent.cjs status",
    "android:debug:logs": "node tests/e2e-android/scripts/android-debug-agent.cjs logs",
    "android:debug:snapshot": "node tests/e2e-android/scripts/android-debug-agent.cjs snapshot",
    "android:debug:screenshot": "node tests/e2e-android/scripts/android-debug-agent.cjs screenshot",
    "android:debug:reload": "node tests/e2e-android/scripts/android-debug-agent.cjs reload",
    "android:debug:stop": "node tests/e2e-android/scripts/android-debug-agent.cjs stop",
    "android:debug:install": "node tests/e2e-android/scripts/android-debug-agent.cjs install",
    "android:debug:grant": "node tests/e2e-android/scripts/android-debug-agent.cjs grant",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "qa:regression": "bash qa/regression.sh",
    "qa:robustness": "bash qa/robustness.sh",
    "tauri": "tauri",
    "check": "vue-tsc --noEmit && cd src-tauri && cargo check --locked",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run src/tests/unit",
    "ci:prepare-android-settings": "node .github/generate-tauri-android-settings.mjs",
    "test:coverage": "vitest run --coverage",
    "perf:apk-size": "node tests/perf/scripts/measure_apk_size.cjs",
    "perf:startup": "node tests/perf/scripts/measure_startup_adb.cjs",
    "perf:collect:full": "node tests/perf/scripts/collect_android_dumpsys.cjs",
    "perf:rust-bench": "node tests/perf/scripts/run_rust_bench.cjs",
    "android:build:phone": "bash scripts/build_android_phone.sh",
    "android:verify:phone": "python3 scripts/verify_android_apk.py src-tauri/gen/android/app/build/outputs/apk/universal/release/app-universal-release.apk --expected-abi arm64-v8a"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-opener": "2.5.4",
    "@vueuse/core": "^14.2.1",
    "date-fns": "^4.1.0",
    "dompurify": "^3.4.2",
    "katex": "^0.16.45",
    "lucide-vue-next": "^0.576.0",
    "marked": "^18.0.4",
    "mermaid": "^11.14.0",
    "morphdom": "^2.7.8",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sortablejs": "^1.15.7",
    "tauri-plugin-vcp-mobile": "file:src-tauri/plugins/vcp-mobile",
    "vue": "^3.5.33",
    "vue-cropper": "^1.1.4",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/ph": "^1.2.2",
    "@pinia/testing": "^1.0.3",
    "@tauri-apps/cli": "2.11.2",
    "@types/katex": "^0.16.8",
    "@types/sortablejs": "^1.15.9",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "@unocss/preset-attributify": "^66.6.8",
    "@unocss/preset-typography": "^66.6.8",
    "@unocss/preset-uno": "^66.6.8",
    "@unocss/reset": "^66.6.8",
    "@unocss/transformer-directives": "^66.6.8",
    "@unocss/transformer-variant-group": "^66.6.8",
    "@unocss/vite": "^66.6.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.9",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.8.3",
    "typescript": "~5.6.3",
    "unocss": "^66.6.8",
    "vite": "^6.4.2",
    "vitest": "^4.1.9",
    "vue-tsc": "^2.2.12"
  }
}
